{
  "name": "governed-sql-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "node scripts/ensure-env.mjs && pnpm --filter @governed-sql/db db:migrate",
    "db:seed": "node scripts/ensure-env.mjs && pnpm --filter @governed-sql/db db:seed",
    "db:generate": "pnpm --filter @governed-sql/db db:generate",
    "db:seed-target": "node scripts/run-seed-target.mjs",
    "db:psql:app": "node scripts/run-psql.mjs app",
    "db:psql:target": "node scripts/run-psql.mjs target",
    "dev:up": "node scripts/run-dev-up.mjs",
    "setup": "node scripts/run-dev-up.mjs && node scripts/ensure-env.mjs && pnpm --filter @governed-sql/db db:migrate && pnpm --filter @governed-sql/db db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.3"
  },
  "packageManager": "pnpm@10.11.0"
}
