# App database (platform metadata, audit, credentials)
DATABASE_URL=postgresql://app:app@localhost:5433/workspace_app

# Target database (Pagila sample data — read-only role)
TARGET_DATABASE_URL=postgresql://pagila_ro:pagila_ro@localhost:5434/pagila

# Used when seeding Pagila (superuser on target-db container)
TARGET_DB_CONTAINER=gsw-target-db
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5434
TARGET_DB_SUPERUSER=postgres
TARGET_DB_SUPERPASS=postgres

# Seeded admin user (pnpm db:seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
SEED_ORG_NAME=Demo Organization

# Pagila connection row stored in app DB (pnpm db:seed)
PAGILA_CONNECTION_HOST=localhost
PAGILA_CONNECTION_PORT=5434
PAGILA_CONNECTION_DATABASE=pagila
PAGILA_CONNECTION_USERNAME=pagila_ro
PAGILA_CONNECTION_PASSWORD=pagila_ro

# API
PORT=3001
SESSION_SECRET=dev-only-session-secret-change-me
COOKIE_SECURE=false

# Encryption key for connection credentials at rest (32+ chars recommended for production)
ENCRYPTION_KEY=dev-only-encryption-key-change-me

# MCP server (Cursor / Claude Desktop) — platform API key, not target DB credentials
# Create via POST /api-keys or use the key printed by pnpm db:seed on first run
# API_KEY=gsw_...
# DEFAULT_CONNECTION_ID=
